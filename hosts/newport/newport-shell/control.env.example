SHELL_MODE=fourorm
SHELL_RUNNER=disabled
HOST=127.0.0.1
PORT=8796
PUBLIC_ORIGIN=https://jackharrhy.dev
FOURORM_ISSUER=https://4orm.harrhy.xyz
SHELL_REQUIRED_SCOPE=newport-shell:execute
# Verified read-only against running 4orm database: exact harrhy, is_admin=1.
SHELL_ALLOWED_SUBJECTS=1
FOURORM_INTROSPECTION_CLIENT_ID=newport-shell-server
FOURORM_INTROSPECTION_SECRET_FILE=/etc/newport-shell/introspection-secret
SHELL_JOURNAL_FILE=/var/lib/newport-shell/jobs.jsonl
