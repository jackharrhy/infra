[Unit]
Description=Authenticated private Browse MCP adapter (Supergateway pilot)
After=browse-relay.service
Requires=browse-relay.service

[Service]
Type=simple
WorkingDirectory=%h
Environment=OPENCODE_BROWSER_AUTO_UPDATE=off
Environment=OPENCODE_BROWSER_UPDATE_CHECK=0
UMask=0077
ExecStart=%h/.local/share/mise/installs/node/26.13.1/bin/node /mnt/terrabud/tools/browse-supergateway-v4.2.2/node_modules/supergateway/dist/index.js --stdio "%h/.local/bin/browse mcp" --host 127.0.0.1 --port 19989 --outputTransport streamableHttp --stateful --sessionTimeout 600000 --apiKeyFile %h/.local/share/browse/mcp-api-key --logLevel none
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true

[Install]
WantedBy=default.target
