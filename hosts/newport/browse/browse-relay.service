[Unit]
Description=Pinned Browse extension relay (Tailnet pilot)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
Environment=OPENCODE_BROWSER_AUTO_UPDATE=off
Environment=OPENCODE_BROWSER_UPDATE_CHECK=0
UMask=0077
ExecStart=%h/.local/bin/browse serve
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true

[Install]
WantedBy=default.target
